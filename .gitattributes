# Series regenerables par le pipeline : en cas de divergence entre une
# execution locale et le workflow horaire, on remplace le fichier au
# lieu de tenter une fusion ligne a ligne, qui n'a aucun sens sur du
# JSON de donnees.
#
# La regle garde la version qui vient d'etre calculee : pendant un
# rebase, c'est celle du commit rejoue. deploy/publish.sh declare le
# pilote « keepnew » automatiquement.
site/data/weather.json    merge=keepnew
site/data/swot_wse.json   merge=keepnew
site/data/lake_area.json  merge=keepnew
site/data/water_extent.json  merge=keepnew
site/data/ebird.json      merge=keepnew
site/data/inaturalist.json  merge=keepnew
site/data/rainfall.json    merge=keepnew
site/data/rivers.json      merge=keepnew
# Attention : la macro « binary » desactive la fusion et annulerait
# merge=keepnew ; on pose donc ses effets utiles un par un.
site/data/rain_maps/*.png    -diff -text merge=keepnew
site/data/area_maps/*.png    -diff -text merge=keepnew
site/data/extent_maps/*.png  -diff -text merge=keepnew
# Memoire des chaines incrementales : meme logique, le fichier qui vient
# d'etre ecrit remplace l'autre.
state/*.json  merge=keepnew
