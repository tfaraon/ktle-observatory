# Service systemd — a copier dans /etc/systemd/system/
#   sudo systemctl enable --now lake-eyre
[Unit]
Description=Kati Thanda - Lake Eyre observatory
After=network.target

[Service]
Type=simple
User=lakeeyre
WorkingDirectory=/srv/lake-eyre-dashboard
Environment="LKE_ALLOW_REFRESH=0"
ExecStart=/srv/lake-eyre-dashboard/.venv/bin/gunicorn \
    -c deploy/gunicorn.conf.py deploy.wsgi:app
Restart=on-failure
RestartSec=5

# Le service ne doit ecrire que dans data/
ProtectSystem=strict
ReadWritePaths=/srv/lake-eyre-dashboard/data
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
