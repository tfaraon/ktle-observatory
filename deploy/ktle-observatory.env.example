# Secrets du serveur, lus par les services systemd.
# A copier en /etc/ktle-observatory.env, puis :
#   sudo chown root:lakeeyre /etc/ktle-observatory.env
#   sudo chmod 640 /etc/ktle-observatory.env
# Ce fichier ne doit jamais etre versionne.

# Cle eBird gratuite : https://ebird.org/api/keygen
EBIRD_API_KEY=

# Compte NASA Earthdata, pour telecharger SWOT : https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
