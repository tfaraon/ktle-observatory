# Reglages de ./update.sh sur ta machine. A copier en deploy/local.env
# (jamais versionne : update.sh l'ajoute a .gitignore).

# Cle eBird gratuite : https://ebird.org/api/keygen
EBIRD_API_KEY=

# Python a utiliser : soit le nom d'un environnement conda...
CONDA_ENV=
# ...soit le chemin d'un interpreteur (prioritaire s'il est rempli)
PYTHON=

# Adresse publique du site, pour verifier que la mise a jour est en ligne.
# A changer le jour ou le site passe sur un nom de domaine.
SITE_URL=https://tfaraon.github.io/ktle-observatory/

# Facultatif : compte NASA Earthdata pour SWOT, si ~/.netrc n'est pas regle
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=

# Memoire des chaines incrementales (niveaux extraits, surfaces par jour).
# A decommenter si le workflow GitHub calcule aussi le SWOT : les deux
# partagent alors le meme etat versionne, au lieu d'en tenir chacun un.
# Le premier passage apres le changement retraite tout une fois.
# KTLE_STATE_DIR=state

# Facultatif : autre emplacement des granules SWOT (disque, montage
# reseau). Vide = paths.swot_data de config.yaml.
# KTLE_SWOT_DIR=
